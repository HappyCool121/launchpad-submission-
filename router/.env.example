# AdRouter LaunchPad local demo. Copy this file to the ignored `.env.local`.
# Replace both placeholders with submission-only credentials. Never commit the
# resulting file or reuse credentials from another environment.
LAUNCHPAD_SUBMISSION=true
ROUTER_RUNTIME_PROFILE=demo

# Shared local profile metadata. The bearer itself is defined once below.
ADROUTER_PROFILE_ID=local-demo
ADROUTER_PROFILE_NAME=AdRouter Local Demo

# This bearer authenticates local CLI/Agent requests to Router. It is distinct
# from the Agnes credential and may be generated with `openssl rand -hex 24`.
ADROUTER_API_KEY=replace_with_new_local_router_bearer

# Agnes remains backend-only. CLI and Agent must never receive this key.
AGNES_ENABLED=true
AGNES_API_KEY=replace_with_new_submission_only_agnes_key
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
ADROUTER_DEFAULT_MODEL=agnes-2.5-flash

# Embeddings provider key. DeepSeek has NO embeddings endpoint, so the semantic
# router uses a separate embedding model. Default provider: OpenAI.
# Swap provider in src/lib/embeddings.ts if you want local MiniLM instead.
OPENAI_API_KEY=

# Server config
PORT=8787
ROUTER_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite campaign and privacy-preserving aggregate analytics store. The
# package-relative default is data/adrouter.sqlite. Use :memory: only for an
# isolated process test; copy the stopped database and its -wal file before an
# upgrade or rollback test.
# ADROUTER_DB_PATH=data/adrouter.sqlite

# Demo-only capabilities. Sponsor inventory and subsidy are synthetic.
ENABLE_DEMO_TIER_OVERRIDE=false
ENABLE_SPONSOR_WRITES=false
