# LaunchPad Agent reference configuration.
# The app defaults to this loopback Router. Enter the local Router bearer in
# the onboarding UI; it is encrypted with Electron safeStorage and is not read
# from this file. Never put AGNES_API_KEY in the Agent environment.
LAUNCHPAD_SUBMISSION=true
ADROUTER_API_URL=http://127.0.0.1:8787
ADROUTER_MODEL_ROUTE=agnes-2.5-flash
