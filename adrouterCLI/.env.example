# LaunchPad CLI configuration. Copy to the ignored `.env.local` and use the
# same new local Router bearer configured in `../router/.env.local`.
# The live Agnes credential belongs only in Router and must not appear here.
LAUNCHPAD_SUBMISSION=true
ADROUTER_API_URL=http://127.0.0.1:8787
ADROUTER_API_KEY=replace_with_new_local_router_bearer
ADROUTER_AD_MODE=live
ADROUTER_RUNTIME_MODE=live
ADROUTER_MODEL_ROUTE=agnes-2.5-flash
# Deprecated compatibility input. Routed outcomes are never suppressed.
ADROUTER_MIN_AD_TIER=3
