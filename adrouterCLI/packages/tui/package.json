{
	"name": "@adrouter/tui",
	"version": "0.81.0-beta.18",
	"private": true,
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"files": [
		"dist/**/*",
		"docs/README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "AdRouter",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/adrouter/adrouterCLI.git",
		"directory": "packages/tui"
	},
	"bugs": {
		"url": "https://github.com/adrouter/adrouterCLI/issues"
	},
	"homepage": "https://github.com/adrouter/adrouterCLI#readme",
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.0.5"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"chalk": "5.6.2"
	}
}
