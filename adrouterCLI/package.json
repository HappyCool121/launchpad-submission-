{
	"name": "adroutercli-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/ai",
		"packages/tui",
		"packages/agent",
		"packages/coding-agent",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox",
		"packages/coding-agent/examples/extensions/gondolin"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "cd packages/tui && npm run build && cd ../ai && npm run build && cd ../agent && npm run build && cd ../coding-agent && npm run build",
		"start:launchpad": "node scripts/launchpad.mjs",
		"check:submission": "npm run build && node scripts/check-submission.mjs",
		"check": "npm run check:submission",
		"format": "biome check --write .",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"catalog:sync": "node scripts/sync-adrouter-catalog.mjs",
		"catalog:generate": "node packages/ai/scripts/generate-models.ts --provider adrouter",
		"catalog:check": "node --test scripts/adrouter-catalog.test.mjs && node scripts/sync-adrouter-catalog.mjs --check",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:shrinkwrap": "node scripts/generate-coding-agent-shrinkwrap.mjs --check",
		"check:branding": "node scripts/check-adrouter-branding.mjs",
		"check:docs": "node scripts/check-docs.mjs",
		"check:public-boundary": "node scripts/check-public-boundary.mjs",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "npm run test --workspaces --if-present",
		"test:isolated": "node scripts/test.mjs",
		"install:local": "npm run build && node scripts/install-local.mjs",
		"link:dev": "npm run build && npm link --workspace @adrouter/cli --ignore-scripts",
		"check:local-install": "node --test scripts/install-local.test.mjs",
		"shrinkwrap:coding-agent": "node scripts/generate-coding-agent-shrinkwrap.mjs",
		"prepare": "node -e \"process.exit(0)\""
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@biomejs/biome": "2.3.5",
		"@cyclonedx/cyclonedx-npm": "6.0.0",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"esbuild": "0.28.1",
		"jiti": "2.7.0",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.81.0-beta.18",
	"overrides": {
		"brace-expansion": "5.0.8",
		"postcss": "8.5.23",
		"protobufjs": "7.6.5",
		"shell-quote": "1.10.0",
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
